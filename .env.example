# 复制为 .env 后填写。.env 已被 .gitignore 排除，不会进版本库。
#
# UGOS_HOST 的 192.0.2.10 是 RFC 5737 文档专用地址（TEST-NET-1，永不可路由），
# 仅为占位示例，请替换为你自己的 NAS 地址。
UGOS_HOST=192.0.2.10
UGOS_PORT=9443
UGOS_USER=
UGOS_PASSWORD=

# --- 中间层（可选）---
# App 访问中间层用的令牌，不是 NAS 密码。留空会启动时随机生成。
API_TOKEN=
SERVER_HOST=0.0.0.0
SERVER_PORT=8787
LOG_LEVEL=INFO
POLL_INTERVAL=60

# --- 告警阈值（可选，留空用代码内默认值）---
# ALERT_DISK_TEMP=50
# ALERT_DISK_TEMP_CRITICAL=58
# ALERT_CPU_TEMP=80
# ALERT_VOLUME_USED=90
# ALERT_VOLUME_USED_CRITICAL=97
# ALERT_FAN_MIN_RPM=100
# ALERT_CONTAINER_RESTART_COUNT=3
# ALERT_CONTAINER_RESTART_WINDOW=600
# ALERT_NIC_MIN_MBPS=0          # 0 = 只检测「相对历史峰值降速」

# --- 磁盘测速（可选）---
# 测速是写盘操作，需要二次密码校验；不允许时改成 false
# BENCHMARK_ALLOW_START=true
# BENCHMARK_POLL_SECONDS=3

# --- APNs 推送（可选，四项齐全才启用；不配则告警只写日志）---
# APNS_KEY_FILE=/app/secrets/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=YYYYYYYYYY
# APNS_TOPIC=com.example.nasmanager
# APNS_USE_SANDBOX=false
