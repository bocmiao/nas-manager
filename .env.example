# 复制为 .env 后填写。.env 已被 .gitignore 排除，不会进版本库。
#
# UGOS_HOST 的 192.0.2.10 是 RFC 5737 文档专用地址（TEST-NET-1，永不可路由），
# 仅为占位示例，请替换为你自己的 NAS 地址。
UGOS_HOST=192.0.2.10
UGOS_PORT=9443
UGOS_USER=
UGOS_PASSWORD=

# --- 中间层（可选）---
# App 访问中间层用的令牌，不是 NAS 密码。留空会启动时随机生成。
API_TOKEN=
SERVER_HOST=0.0.0.0
SERVER_PORT=8787
LOG_LEVEL=INFO
POLL_INTERVAL=60

# --- 告警阈值（可选，留空用代码内默认值）---
# ALERT_DISK_TEMP=50
# ALERT_DISK_TEMP_CRITICAL=58
# ALERT_CPU_TEMP=80
# ALERT_VOLUME_USED=90
# ALERT_VOLUME_USED_CRITICAL=97
# ALERT_FAN_MIN_RPM=100
# ALERT_CONTAINER_RESTART_COUNT=3
# ALERT_CONTAINER_RESTART_WINDOW=600
# ALERT_NIC_MIN_MBPS=0          # 0 = 只检测「相对历史峰值降速」

# --- 第三批告警阈值（可选）---
# ALERT_CONTAINER_EXPECTED_POLLS=3   # 连续 N 轮 running 才认定「期望运行」
# ALERT_CONTAINER_RESTART_COUNT=3
# ALERT_DISK_WAKE_COUNT=6            # 窗口内唤醒次数阈值
# ALERT_DISK_WAKE_WINDOW=3600        # 窗口（秒）
# ALERT_SERVICE_EXPECTED_POLLS=3     # 连续 N 轮存在才认定服务「期望在跑」
# ALERT_REQUIRED_SERVICES=           # 逗号分隔，强制常驻的进程名，如 sshd,smbd（缺失即 critical）
# ALERT_NIC_ERROR_DELTA=100          # 网口错误包增量阈值（UGOS 无此数据，暂不触发）
# ALERT_NIC_ERROR_WINDOW=600
# ALERT_VOLUME_INODE=90              # inode 使用率阈值（UGOS 无此数据，暂不触发）
# ALERT_VOLUME_INODE_CRITICAL=95

# --- 第四批告警阈值（可选）---
# ALERT_LOGIN_FAIL_COUNT=10          # 同一来源 IP 在窗口内登录失败次数阈值
# ALERT_LOGIN_FAIL_WINDOW=300        # 窗口（秒）；NAS 自带 faillock 默认 6 次/5 分钟锁定
# ALERT_BACKUP_STALE_HOURS=48        # 备份任务超过该小时数未成功运行即告警，0 = 关闭

# --- 第四批缓存 TTL（可选，秒）---
# TTL_SESSIONS=5                     # 在线会话变化快，缓存要短
# TTL_BACKUP=30
# TTL_FANS=5
# TTL_VM=300                         # 虚拟机模块是否存在极少变化

# --- 磁盘测速（可选）---
# 测速是写盘操作，需要二次密码校验；不允许时改成 false
# BENCHMARK_ALLOW_START=true
# BENCHMARK_POLL_SECONDS=3

# --- 镜像拉取（可选）---
# IMAGE_ALLOW_PULL=true
# IMAGE_PULL_POLL_SECONDS=3

# --- 历史采样（可选，内存环形缓冲，重启清空）---
# HISTORY_ENABLED=true
# HISTORY_INTERVAL=60          # 采样间隔（秒）
# HISTORY_POINTS=360           # 每指标保留点数，360 × 60s = 6 小时

# --- APNs 推送（可选，四项齐全才启用；不配则告警只写日志）---
# APNS_KEY_FILE=/app/secrets/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=YYYYYYYYYY
# APNS_TOPIC=com.example.nasmanager
# APNS_USE_SANDBOX=false
